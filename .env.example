# CCN-authenticated Circle user-controlled wallet spike
CIRCLE_API_KEY=
NEXT_PUBLIC_CIRCLE_APP_ID=
INTERNAL_SPIKE_ACCESS_KEY=

# Supabase auth and Creator Foundation persistence.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public application URL used for auth redirects and metadata.
# Set this to the final Vercel production origin, without a trailing path.
NEXT_PUBLIC_SITE_URL=https://creator-challenge-network.vercel.app

# Lifecycle persistence.
# Production/serverless must use Supabase and must not fall back to .local JSON.
CCN_LIFECYCLE_PERSISTENCE=supabase
# Optional local deterministic test override. Use filesystem only outside production.
CCN_CREATE_CHALLENGE_STORE_PATH=

# CCN escrow deployment placeholders for a later task.
# Public Arc Testnet USDC ERC-20 interface address.
ARC_TESTNET_USDC=0x3600000000000000000000000000000000000000
CCN_TREASURY_ADDRESS=
CCN_ADMIN_ADDRESS=
CCN_RESOLVER_ADDRESS=
CCN_PAUSER_ADDRESS=
# Leave empty here. Never commit a real private key.
DEPLOYER_PRIVATE_KEY=

# Active Arc Testnet CCNEscrow runtime configuration.
# Public addresses only; no secrets.
CCN_ESCROW_CONTRACT_ADDRESS=0x4DCE98F8a35d09F57ECE7A340B8392Ba0Fb7ba3D
CCN_PAYOUT_TREASURY_ADDRESS=0x6d2ca88a7bDA59280D9ad0E41aA87C9acF24Aa1A
CCN_PAYOUT_ACCOUNT_ID=
CCN_PAYOUT_WALLET_ID=
CCN_PAYOUT_WALLET_ADDRESS=

# Arc Testnet smoke-test deadlines. Defaults remain 86400/86400 when unset.
CCN_SMOKE_TEST_MODE=false
CCN_ENABLE_SHORT_SMOKE_WINDOWS=false
CCN_AUTH_TEST_MODE=false
CCN_INCLUDE_STATIC_CHALLENGE_MOCKS=false
# Short smoke windows are fail-closed in production and never go below 15 minutes.
CCN_MIN_SUBMISSION_WINDOW_SECONDS=900
CCN_MIN_REVIEW_WINDOW_SECONDS=900


# Optional OAuth provider visibility flags. Providers stay hidden unless explicitly enabled.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_GITHUB_ENABLED=false
